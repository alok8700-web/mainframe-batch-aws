*> ------------------------------------------------------------
*> DAILYTXN - daily transaction batch job (practice project)
*> Reads a fixed-width transaction file, validates each record,
*> writes a report and a reject file, and sets a return code:
*>   0 = all good, 4 = some records rejected, 12 = file error
*> Compile with: cobc -x -free -o bin/dailytxn cobol/DAILYTXN.cbl
*> ------------------------------------------------------------
IDENTIFICATION DIVISION.
PROGRAM-ID. DAILYTXN.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TXN-IN ASSIGN TO TXNIN
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS-IN.
    SELECT RPT-OUT ASSIGN TO RPTOUT
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS-RPT.
    SELECT REJ-OUT ASSIGN TO REJOUT
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FS-REJ.

DATA DIVISION.
FILE SECTION.
FD TXN-IN.
01 TXN-REC.
   05 TXN-ID        PIC X(8).
   05 TXN-ACCT      PIC X(10).
   05 TXN-TYPE      PIC X(1).
   05 TXN-AMT-X     PIC X(9).
   05 TXN-AMT       REDEFINES TXN-AMT-X PIC 9(7)V99.
   05 TXN-DATE      PIC X(8).

FD RPT-OUT.
01 RPT-REC          PIC X(80).

FD REJ-OUT.
01 REJ-REC          PIC X(80).

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS.
   05 WS-FS-IN      PIC XX.
   05 WS-FS-RPT     PIC XX.
   05 WS-FS-REJ     PIC XX.

01 WS-SWITCHES.
   05 WS-EOF-SW     PIC X VALUE "N".
      88 END-OF-FILE      VALUE "Y".

01 WS-REASON        PIC X(12) VALUE SPACES.
   88 VALID-TXN     VALUE SPACES.

01 WS-COUNTERS.
   05 WS-READ-CNT   PIC 9(7) VALUE 0.
   05 WS-OK-CNT     PIC 9(7) VALUE 0.
   05 WS-REJ-CNT    PIC 9(7) VALUE 0.

01 WS-TOTALS.
   05 WS-DEBIT-TOT  PIC 9(9)V99 VALUE 0.
   05 WS-CREDIT-TOT PIC 9(9)V99 VALUE 0.

01 WS-EDITED.
   05 WS-AMT-ED     PIC Z,ZZZ,ZZ9.99.
   05 WS-TOT-ED     PIC ZZZ,ZZZ,ZZ9.99.
   05 WS-CNT-ED     PIC Z,ZZZ,ZZ9.

PROCEDURE DIVISION.
0000-MAIN.
    PERFORM 1000-INIT
    PERFORM 2000-PROCESS UNTIL END-OF-FILE
    PERFORM 3000-FINISH
    STOP RUN.

1000-INIT.
    OPEN INPUT TXN-IN
    IF WS-FS-IN NOT = "00"
        DISPLAY "DAILYTXN: CANNOT OPEN TXNIN, STATUS " WS-FS-IN
        MOVE 12 TO RETURN-CODE
        STOP RUN
    END-IF
    OPEN OUTPUT RPT-OUT
    IF WS-FS-RPT NOT = "00"
        DISPLAY "DAILYTXN: CANNOT OPEN RPTOUT, STATUS " WS-FS-RPT
        MOVE 12 TO RETURN-CODE
        STOP RUN
    END-IF
    OPEN OUTPUT REJ-OUT
    IF WS-FS-REJ NOT = "00"
        DISPLAY "DAILYTXN: CANNOT OPEN REJOUT, STATUS " WS-FS-REJ
        MOVE 12 TO RETURN-CODE
        STOP RUN
    END-IF
    MOVE "DAILY TRANSACTION REPORT" TO RPT-REC
    WRITE RPT-REC
    MOVE "TXN-ID   ACCOUNT    T       AMOUNT DATE" TO RPT-REC
    WRITE RPT-REC
    PERFORM 2900-READ-NEXT.

2000-PROCESS.
    PERFORM 2100-VALIDATE
    IF VALID-TXN
        PERFORM 2200-ACCEPT
    ELSE
        PERFORM 2300-REJECT
    END-IF
    PERFORM 2900-READ-NEXT.

2100-VALIDATE.
    MOVE SPACES TO WS-REASON
    EVALUATE TRUE
        WHEN TXN-TYPE NOT = "D" AND TXN-TYPE NOT = "C"
            MOVE "BAD TYPE" TO WS-REASON
        WHEN TXN-AMT-X IS NOT NUMERIC
            MOVE "BAD AMOUNT" TO WS-REASON
        WHEN TXN-DATE IS NOT NUMERIC
            MOVE "BAD DATE" TO WS-REASON
    END-EVALUATE.

2200-ACCEPT.
    ADD 1 TO WS-OK-CNT
    IF TXN-TYPE = "D"
        ADD TXN-AMT TO WS-DEBIT-TOT
    ELSE
        ADD TXN-AMT TO WS-CREDIT-TOT
    END-IF
    MOVE TXN-AMT TO WS-AMT-ED
    MOVE SPACES TO RPT-REC
    STRING TXN-ID " " TXN-ACCT " " TXN-TYPE " " WS-AMT-ED " " TXN-DATE
        DELIMITED BY SIZE INTO RPT-REC
    WRITE RPT-REC.

2300-REJECT.
    ADD 1 TO WS-REJ-CNT
    MOVE SPACES TO REJ-REC
    STRING TXN-REC " REASON=" WS-REASON
        DELIMITED BY SIZE INTO REJ-REC
    WRITE REJ-REC.

2900-READ-NEXT.
    READ TXN-IN
        AT END SET END-OF-FILE TO TRUE
        NOT AT END ADD 1 TO WS-READ-CNT
    END-READ.

3000-FINISH.
    MOVE WS-DEBIT-TOT TO WS-TOT-ED
    MOVE SPACES TO RPT-REC
    STRING "TOTAL DEBITS  : " WS-TOT-ED DELIMITED BY SIZE INTO RPT-REC
    WRITE RPT-REC
    MOVE WS-CREDIT-TOT TO WS-TOT-ED
    MOVE SPACES TO RPT-REC
    STRING "TOTAL CREDITS : " WS-TOT-ED DELIMITED BY SIZE INTO RPT-REC
    WRITE RPT-REC

    MOVE WS-READ-CNT TO WS-CNT-ED
    DISPLAY "DAILYTXN: RECORDS READ     " WS-CNT-ED
    MOVE WS-OK-CNT TO WS-CNT-ED
    DISPLAY "DAILYTXN: RECORDS ACCEPTED " WS-CNT-ED
    MOVE WS-REJ-CNT TO WS-CNT-ED
    DISPLAY "DAILYTXN: RECORDS REJECTED " WS-CNT-ED

    CLOSE TXN-IN RPT-OUT REJ-OUT

    IF WS-REJ-CNT > 0
        MOVE 4 TO RETURN-CODE
    ELSE
        MOVE 0 TO RETURN-CODE
    END-IF.
