//DAILYTXN JOB (ACCT),'ALOK',CLASS=A,MSGCLASS=X
//* Reference JCL: how this job would run on z/OS.
//* On AWS, each DD below becomes an S3 path or environment variable.
//STEP010  EXEC PGM=DAILYTXN
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//TXNIN    DD DSN=PROD.DAILY.TXN.INPUT,DISP=SHR
//RPTOUT   DD DSN=PROD.DAILY.TXN.REPORT,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80)
//REJOUT   DD DSN=PROD.DAILY.TXN.REJECTS,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
